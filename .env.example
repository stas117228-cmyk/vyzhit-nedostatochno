# Переменные окружения

# ──────────────────────────────────────────────
# РЕЖИМ САЙТА (обязательно)
# ──────────────────────────────────────────────
# Допустимые значения: prototype | live
# По умолчанию (до получения всех материалов): prototype
# На Vercel Preview оставляй prototype
# На Vercel Production переключай в live только после подключения всех интеграций
NEXT_PUBLIC_SITE_MODE=prototype

# ──────────────────────────────────────────────
# СТОИМОСТЬ КНИГИ (заполнить перед запуском)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_BOOK_PRICE=
# NEXT_PUBLIC_BOOK_CURRENCY=RUB

# ──────────────────────────────────────────────
# ПЛАТЁЖНЫЙ СЕРВИС (серверная часть, не NEXT_PUBLIC_)
# ──────────────────────────────────────────────
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# ОТПРАВКА ФОРМ (серверная часть)
# ──────────────────────────────────────────────
# FORMS_WEBHOOK_URL=        # URL для получения заявок (мастерская, выступления)
# FORMS_SECRET_KEY=

# ──────────────────────────────────────────────
# СОЦИАЛЬНЫЕ СЕТИ (замени # на реальные URL)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/...
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/...
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@...
# NEXT_PUBLIC_SOCIAL_VK=https://vk.com/...
